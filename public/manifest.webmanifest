{
  "name": "Finance Journal",
  "short_name": "Finance Journal",
  "description": "Personal finance tracker for monitoring income, expenses, budgets, and analytics.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#193f2d",
  "background_color": "#0b1e15",
  "icons": [
